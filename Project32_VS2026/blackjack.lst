 000002AB  E8 00000000 E		call WriteChar
 000002B0  E8 FFFFFF73			call PrintSuit
 000002B5  B0 5D			mov al,']'
 000002B7  E8 00000000 E		call WriteChar
 000002BC  B0 20			mov al,' '
 000002BE  E8 00000000 E		call WriteChar
 000002C3  59				pop ecx
 000002C4  C3				ret
 000002C5			PrintCard ENDP

