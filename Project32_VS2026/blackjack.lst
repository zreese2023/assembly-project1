 00000000			.code

 00000000			Draw PROC
					; get a random card procedure (1-13)
 00000000  B8 0000000D			mov eax,13 ; 13 possible card values
 00000005  E8 00000000 E		call RandomRange ; irvine32 procedure, puts a random integer into eax from range 0 to eax-1
					; NOTE: RandomRange was not taught in class, so i consulted the internet/AI for the documentation
					; on how to get random numbers in MASM with the irvine library.
 0000000A  40				inc eax ; 0 isnt a possible value, so add 1 to eax so we have values 1-13
 0000000B  8B C8			mov ecx,eax ; move result to ecx use in determining value (if ace or face card)
 0000000D  C3				ret
 0000000E			Draw ENDP

 0000000E			DrawSuit PROC
					; gets a random suit for the card
					; 0: spades
					; 1: clubs
					; 2: hearts
					; 3: diamonds
 0000000E  B8 00000004			mov eax,4
 00000013  E8 00000000 E		call RandomRange
 00000018  C3				ret
 00000019			DrawSuit ENDP

 00000019			ShowWallet PROC ; procedure to print the players total money
 00000019  BA 00000315 R		mov edx,OFFSET wallet
 0000001E  E8 00000000 E		call WriteString
 00000023  A1 0000030D R		mov eax,playerWallet
 00000028  E8 00000000 E		call WriteDec
 0000002D  E8 00000000 E		call Crlf
 00000032  C3				ret
 00000033			ShowWallet ENDP

 00000033			PlayerBet PROC
 00000033			L1:
 00000033  E8 FFFFFFE1			call ShowWallet ; print wallet
 00000038  BA 00000324 R		mov edx, OFFSET betPrint
 0000003D  E8 00000000 E		call WriteString
 00000042  E8 00000000 E		call ReadDec ; get player bet
 00000047  E8 00000000 E		call Crlf

					; check validity of bet, jump to invalid if invalid
 0000004C  83 F8 00			cmp eax,0
 0000004F  74 0E			je invalid
 00000051  3B 05 0000030D R		cmp eax,playerWallet
 00000057  7F 06			jg invalid
 00000059  A3 00000311 R		mov bet,eax
 0000005E  C3				ret
 0000005F			invalid: ; prompt player to re type bet if invalid
 0000005F  BA 00000330 R		mov edx,OFFSET invalidBet
 00000064  E8 00000000 E		call WriteString
 00000069  A1 0000030D R		mov eax,playerWallet
 0000006E  E8 00000000 E		call WriteDec
 00000073  E8 00000000 E		call Crlf
 00000078  EB B9			jmp L1
 0000007A			PlayerBet ENDP

 0000007A			WinBet PROC ; pay player even money for winning a bet
					; if the player wins they are paid 2:1 for their bet
 0000007A  A1 0000030D R		mov eax,playerWallet
 0000007F  03 05 00000311 R		add eax,bet
 00000085  A3 0000030D R		mov playerWallet,eax
 0000008A  C3				ret
 0000008B			WinBet ENDP

 0000008B			LoseBet PROC ; if player loses the hand they lose whatever their wager was
 0000008B  A1 0000030D R		mov eax,playerWallet
 00000090  2B 05 00000311 R		sub eax,bet
 00000096  A3 0000030D R		mov playerWallet,eax
 0000009B  C3				ret
 0000009C			LoseBet ENDP

 0000009C			BlackjackPay PROC
					; special case for blackjack payout: player blackjack pays 3:2
 0000009C  A1 00000311 R		mov eax,bet
 000000A1  BB 00000003			mov ebx,3 ; multiply by 3
 000000A6  F7 E3			mul ebx
 000000A8  BB 00000002			mov ebx,2 ; div by 2
 000000AD  F7 F3			div ebx
 000000AF  01 05 0000030D R		add playerWallet,eax
 000000B5  C3				ret
 000000B6			BlackjackPay ENDP

 000000B6			Value PROC
					; get card value, input is placed in ecx (moved there in Draw proc)
 000000B6  8B C1			mov eax,ecx ; get input from ecx from Draw proc
 000000B8  83 F8 01			cmp eax,1 ; if ace card jump to ace label
 000000BB  74 13			je ace
 000000BD  83 F8 0B			cmp eax,11 ; if not a face card
 000000C0  72 05			jb standard
 000000C2  83 F8 0C			cmp eax,12 ; jump to faceCard label if greater or equal to 12
 000000C5  7D 03			jge faceCard
 000000C7			standard: ; regular card
 000000C7  8B C1			mov eax,ecx ; move result to eax
 000000C9  C3				ret ; return eax
 000000CA			faceCard: ; face card
 000000CA  B8 0000000A			mov eax,10 ; move 10 (face card value) to eax
 000000CF  C3				ret ; return eax
 000000D0			ace: ; ace
 000000D0  B8 0000000B			mov eax,11 ; move 11 (will update ace logic later) to eax
 000000D5  C3				ret ; return
 000000D6			Value ENDP

