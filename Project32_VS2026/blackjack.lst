 000001CE  83 F8 0B			cmp eax,11 ; if ace
 000001D1  75 0A		    jne noAce ; jump if not ace
 000001D3  C7 05 000003D0 R	    mov dealerAce,1 ; set dealer ace flag if dealer gets an ace
	   00000001
 000001DD			noAce: ; uses same logic as player drawing an ace but modifies dealer variables
					   ; therefore refer to DrawP for documentation of logic.
 000001DD  01 05 0000038B R	    add dealerScore,eax
 000001E3  83 3D 0000038B R	    cmp dealerScore,21
	   15
 000001EA  7E 1A		    jle L1
 000001EC  83 3D 000003D0 R	    cmp dealerAce,1
	   01
 000001F3  75 11		    jne L1
 000001F5  83 2D 0000038B R	    sub dealerScore,10
	   0A
 000001FC  C7 05 000003D0 R	    mov dealerAce,0
	   00000000
