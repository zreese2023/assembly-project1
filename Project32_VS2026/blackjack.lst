 00000228			PrintSuit PROC
					; prints the appropriate ASCII character for the corresponding suit
					; 0=spade
					; 1=club
					; 2=hearts
					; 3=diamonds
 00000228  50				push eax ; must preserve eax because card value will be in eax
 00000229  51				push ecx
 0000022A  53				push ebx
 0000022B  83 FB 02			cmp ebx,2
 0000022E  7D 0C			jge RedSuit ; 2-3 are red suits, 0-1 are black (printed as white) suits
 00000230  B8 0000000F			mov eax,(black*16)+white
 00000235  E8 00000000 E		call SetTextColor
 0000023A  EB 0A			jmp Print
 0000023C			RedSuit:
 0000023C  B8 00000004			mov eax,(black*16)+red
 00000241  E8 00000000 E		call SetTextColor
 00000246			Print:
					;branching for suits to load suit into ebx
 00000246  83 FB 00			cmp ebx,0
 00000249  74 11			je Spade
 0000024B  83 FB 01			cmp ebx,1
 0000024E  74 13			je Club
 00000250  83 FB 02			cmp ebx,2
 00000253  74 15			je Heart
 00000255  BA 00000305 R		mov edx,OFFSET suitDiamond
 0000025A  EB 15			jmp Write
 0000025C			Spade:
 0000025C  BA 000002F4 R		mov edx,OFFSET suitSpade
 00000261  EB 0E			jmp Write
 00000263			Club:
 00000263  BA 000002FA R		mov edx,OFFSET suitClub
 00000268  EB 07			jmp Write
 0000026A			Heart:
 0000026A  BA 000002FF R		mov edx,OFFSET suitHeart
 0000026F  EB 00			jmp Write
 00000271			Write:
 00000271  E8 00000000 E		call WriteString
 00000276  B8 0000000F			mov eax,(black*16)+white ; reset text color
 0000027B  E8 00000000 E		call SetTextColor
 00000280  5B				pop ebx
 00000281  59				pop ecx
 00000282  58				pop eax
 00000283  C3				ret
 00000284			PrintSuit ENDP

