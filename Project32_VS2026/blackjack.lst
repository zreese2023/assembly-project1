 0000015C			DrawP PROC
					; Player drawing cards procedure
 0000015C  E8 FFFFFE9F			call Draw ; get random card value
 00000161  8B C8			mov ecx,eax
 00000163  E8 FFFFFF4E			call Value ; get card value
 00000168  83 F8 0B			cmp eax,11 ; if ace drawn
 0000016B  75 0A			jne noAce ; if not an ace jump
 0000016D  C7 05 000003CC R		mov playerAce,1 ; otherwise set ace flag
	   00000001
 00000177			noAce: ; not an ace
 00000177  01 05 00000383 R	    add playerScore,eax ; add drawn card to score
 0000017D  83 3D 00000383 R	    cmp playerScore,21 ; check if 21
	   15
 00000184  7E 1A		    jle L1 ; if less than 21
 00000186  83 3D 000003CC R	    cmp playerAce,1 ; if ace flag set
	   01
 0000018D  75 11		    jne L1 ; jump if ace flag not set
 0000018F  83 2D 00000383 R	    sub playerScore,10 ; subtract 10 from player score (ace treated as 1 instead of 11 for score)
	   0A
 00000196  C7 05 000003CC R	    mov playerAce,0 ; reset ace flag
	   00000000
 000001A0			L1:
 000001A0  8B 1D 0000037F R	    mov ebx,playerCount ; index for player card array
 000001A6  89 04 9D		    mov pCardArray[ebx*4],eax ; put card into array
	   00000000 R
 000001AD  53				push ebx
 000001AE  E8 FFFFFE5B			call DrawSuit ; get the suit for the card into player suit array
 000001B3  5B				pop ebx
 000001B4  89 04 9D			mov pSuitArray[ebx*4],eax
	   000002CC R
 000001BB  FF 05 0000037F R	    inc playerCount ; move to next index
 000001C1  C3			    ret
 000001C2			DrawP ENDP

 000001C2			DrawD PROC
					; Draw dealer cards procedure, same logic as DrawP proc
 000001C2  E8 FFFFFE39			call Draw ; get random number
 000001C7  8B C8			mov ecx,eax ; move ecx to eax for Value proc
